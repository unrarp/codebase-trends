{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Site in Chromium",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/snap/bin/chromium",
      "userDataDir": "${env:HOME}/snap/chromium/common/vscode-debug-profile",
      "url": "http://localhost:8090/codebase-trends/",
      "webRoot": "${workspaceFolder}/src/site",
      "pathMapping": { "/codebase-trends/": "${workspaceFolder}/src/site/" }
    },
    {
      "name": "Dev server",
      "type": "node",
      "request": "launch",
      "runtimeVersion": "22.22.0",
      "program": "${workspaceFolder}/scripts/dev.ts",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Current file",
      "type": "node",
      "request": "launch",
      "runtimeVersion": "22.22.0",
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Current test file",
      "type": "node",
      "request": "launch",
      "runtimeVersion": "22.22.0",
      "runtimeArgs": ["--test"],
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
